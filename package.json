{
  "name": "trustcheck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TrustCheck - student scam-awareness assistant (college project)",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev": "concurrently -n BE,FE -c blue,magenta \"npm:dev:be\" \"npm:dev:fe\"",
    "dev:be": "tsx watch BE/src/server.ts",
    "dev:fe": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx BE/src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend BE netlify shared",
    "lint:fix": "eslint frontend BE shared --fix"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript-eslint": "^8.35.0"
  }
}
