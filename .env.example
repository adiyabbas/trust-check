# ---------- LLM provider ----------
# Which provider to use: groq | gemini | openrouter | openai | none
# "none" = rules only, no AI explanations (still works for the demo).
LLM_PROVIDER=groq

# Groq (recommended: free tier, no credit card) -> https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (free tier) -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter (free ":free" models, 50 req/day) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI (paid) -> https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the default model for the chosen provider.
# Defaults: groq=openai/gpt-oss-120b, gemini=gemini-2.5-flash,
#           openrouter=openai/gpt-oss-20b:free, openai=gpt-4o-mini
LLM_MODEL=

# ---------- Optional link reputation ----------
# Google Safe Browsing Lookup API key (free) -> https://console.cloud.google.com/
# Leave empty to use built-in heuristics only.
SAFE_BROWSING_API_KEY=

# ---------- Server ----------
PORT=3001
